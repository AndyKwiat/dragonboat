; Godot 4.7 C# port of the Rust/Bevy voxel demo (see ../src) for comparison.
config_version=5

[application]
config/name="Godot C# Voxel Demo (comparison)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#")

[dotnet]
project/assembly_name="GodotVoxelDemo"

[display]
window/size/viewport_width=1000
window/size/viewport_height=1000

[rendering]
renderer/rendering_method="forward_plus"
